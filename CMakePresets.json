{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 20, "patch": 0},
  "configurePresets": [
    {"name": "native", "displayName": "Linux native", "binaryDir": "out/build/native",
     "generator": "Ninja", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "mingw64", "displayName": "Windows x64 (MinGW cross)", "binaryDir": "out/build/mingw64",
     "generator": "Ninja", "toolchainFile": "cmake/toolchain-mingw64.cmake",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "msvc", "displayName": "Windows x64 (MSVC)", "binaryDir": "out/build/msvc",
     "generator": "Visual Studio 17 2022", "architecture": "x64"}
  ],
  "buildPresets": [
    {"name": "native", "configurePreset": "native"},
    {"name": "mingw64", "configurePreset": "mingw64"},
    {"name": "msvc", "configurePreset": "msvc", "configuration": "Release"}
  ],
  "testPresets": [
    {"name": "native", "configurePreset": "native", "output": {"outputOnFailure": true}},
    {"name": "msvc", "configurePreset": "msvc", "configuration": "Release", "output": {"outputOnFailure": true}}
  ]
}
